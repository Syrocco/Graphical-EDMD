-    TRACELOG(LOG_WARNING, "GetWindowScaleDPI() not implemented on target platform");
-    return (Vector2){ 1.0f, 1.0f };
+    Vector2 scale = { 1.0f, 1.0f };
+    if (platform.handle != NULL) glfwGetWindowContentScale(platform.handle, &scale.x, &scale.y);
+
+    // GLFW owns this value so mouse, window and framebuffer coordinates stay
+    // coherent. Fall back to the browser only while the window is starting.
+    if (!isfinite(scale.x) || (scale.x <= 0.0f)) scale.x = (float)emscripten_get_device_pixel_ratio();
+    if (!isfinite(scale.y) || (scale.y <= 0.0f)) scale.y = scale.x;
+    if (!isfinite(scale.x) || (scale.x <= 0.0f)) scale.x = 1.0f;
+    if (!isfinite(scale.y) || (scale.y <= 0.0f)) scale.y = 1.0f;
+    return scale;
